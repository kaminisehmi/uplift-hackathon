# .env.example — copy to .env and fill in your values.
# DO NOT commit .env to version control (it is already in .gitignore).

# IBM Cloud IAM API key — https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=your-ibm-cloud-api-key-here

# watsonx.ai project ID — found in the project's Manage tab
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# watsonx.ai service endpoint URL (region-specific)
# Example: https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
